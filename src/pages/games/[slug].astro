---
import Layout from "../../layouts/Layout.astro";
import BilibiliEmbed from "../../components/BilibiliEmbed.astro";
import DownloadList from "../../components/DownloadList.astro";
import { withBase } from "../../lib/paths";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const games = await getCollection("games");
  return games.map((game) => ({
    params: { slug: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
const { Content } = await render(game);
const { title, genre, year, platforms, cover, screenshots, bilibiliBvid, downloads } = game.data;
---

<Layout title={`${title} · Xia Dynasty`} description={`${title} — ${genre}，${platforms.join(" / ")}`}>
  <article>
    <p class="meta" style="margin-bottom: 0.6rem;">
      <a href={withBase()}>作品</a>
      <span>/</span>
      <span>{title}</span>
    </p>
    <h1>{title}</h1>
    <p class="meta">
      <span class="chip">{genre}</span>
      <span class="chip">{year}</span>
      {platforms.map((p) => <span class="chip">{p}</span>)}
    </p>

    <div class="gallery" style="margin-top: 1.4rem;">
      <img src={withBase(cover)} alt={`${title} 封面`} />
      {screenshots.map((src, i) => <img src={withBase(src)} alt={`${title} 截图 ${i + 1}`} />)}
    </div>

    <div class="prose">
      <Content />
    </div>

    {bilibiliBvid ? (
      <>
        <h2 class="section-title">演示视频</h2>
        <BilibiliEmbed bvid={bilibiliBvid} />
      </>
    ) : (
      <>
        <h2 class="section-title">演示视频</h2>
        <p class="note">演示视频尚未上传。有 B 站稿件后，在对应 Markdown 里填写 bilibiliBvid 即可嵌入。</p>
      </>
    )}

    <h2 class="section-title">下载</h2>
    <DownloadList items={downloads} />
  </article>
</Layout>
